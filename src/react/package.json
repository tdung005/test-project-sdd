{
  "name": "sdd-evidence-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --force --host",
    "build": "tsc && vite build",
    "serve": "npx serve build -l 4000",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{tsx,jsx,ts,js,less}\"",
    "lint": "eslint \"src/**/*.{tsx,jsx,ts,js}\" --fix",
    "update-all": "npx -p npm-check-updates ncu -u && npm install",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npx playwright test",
    "test:e2eui": "npx playwright test --ui",
    "test:unit": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@reduxjs/toolkit": "^2.12.0",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-query-devtools": "^5.62.7",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.2",
    "antd": "^6.4.3",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "github-markdown-css": "^5.9.0",
    "lucide-react": "^0.469.0",
    "query-string": "^9.4.0",
    "rc-tween-one": "^3.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.0.5",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0",
    "web-vitals": "^3.5.2",
    "zustand": "^5.0.2",
    "react-redux": "^9.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-define-config": "^2.1.0",
    "eslint-plugin-case-police": "^0.6.1",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-sonarjs": "^1.0.3",
    "globals": "^15.14.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "@babel/plugin-transform-runtime": "^7.24.7",
    "@babel/preset-env": "^7.25.3",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@faker-js/faker": "^8.4.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/slug": "^5.0.7",
    "@vitest/coverage-v8": "^3.0.0",
    "@vitest/ui": "^3.0.0",
    "husky": "^9.1.2",
    "jsdom": "^24.1.1",
    "less": "4.2.0",
    "less-loader": "12.2.0",
    "lint-staged": "^15.2.7",
    "prettier": "^3.2.5",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "vite-tsconfig-paths": "^4.3.1",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "less": "4.2.0",
    "less-loader": "12.2.0",
    "postcss": "8.4.35"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "*.ts?(x)": [
      "npm run lint",
      "npm run format",
      "git add ."
    ]
  }
}